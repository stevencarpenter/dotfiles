#!/usr/bin/env bash
set -euo pipefail

# Post-apply hook: sync Claude Code skills from the skills manifest.
# Triggered by: chezmoi apply
#
# Self-gates on the `skills` machine capability — on machines where
# skills=false the body collapses to a no-op. The .chezmoiignore already
# excludes ~/.config/skills/ on those machines.
#
# sync-skills ships as an entry point of the mcp_sync uv project (alongside
# sync-mcp-configs) — the shared body's project dir is mcp_sync/ by design,
# not a slip. Body shared with run_after_sync-mcp.sh.tmpl via
# .chezmoitemplates/sync-hook-body.sh.

{{ template "sync-hook-body.sh" dict
     "machine" .machine
     "machines" .machines
     "capability" "skills"
     "label" "Skill sync"
     "entrypoint" "sync-skills" }}
