#!/usr/bin/env bash
set -euo pipefail

# Post-apply hook: sync MCP configurations from the master config
# Triggered by: chezmoi apply
#
# Self-gates on the `mcp` machine capability — on machines where mcp=false
# the body collapses to a no-op. The .chezmoiignore already excludes
# ~/.config/mcp/ on those machines, so there'd be no master config to sync
# anyway. Today no machine has mcp=false; the gate exists for future
# headless/server-only machines.
#
# Body shared with run_after_sync-skills.sh.tmpl via
# .chezmoitemplates/sync-hook-body.sh.

{{ template "sync-hook-body.sh" dict
     "machine" .machine
     "machines" .machines
     "capability" "mcp"
     "label" "MCP sync"
     "entrypoint" "sync-mcp-configs" }}
