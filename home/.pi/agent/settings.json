{
  "defaultProjectTrust": "ask",
  "shellPath": "/opt/homebrew/bin/bash",
  "shellCommandPrefix": "export PATH=/opt/homebrew/opt/bash/bin:$PATH",
  "defaultProvider": "openai-codex",
  "packages": [
    "npm:pi-mcp-adapter@3.2.0",
    "npm:pi-web-access@0.33.0",
    "npm:pi-subagents@0.73.1",
    "npm:@dietrichgebert/ponytail@4.10.0",
    "npm:pi-background-tasks@2.6.8",
    "npm:@narumitw/pi-goal@0.54.8",
    "npm:@earendil-works/pi-client",
    "npm:@earendil-works/pi-server"
  ],
  "lastChangelogVersion": "1.0.4",
  "theme": "everforest-dark-hard",
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "auto",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "tuiMode": "regular",
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-luna": "xhigh",
    "openai-codex/gpt-6-astra": "medium"
  },
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium"
}