# Shared SSH defaults. Personal fragments are op-rendered 10-*.conf files;
# work fragments are 20-*.conf files owned by the external work repository.
# OrbStack's include must precede Host blocks; OrbStack will not restore it.
Include ~/.orbstack/ssh/config

# Include fragments before Host defaults: SSH uses the first value for each key.
# Match only .conf files to exclude editor backups and render temporary files.
# Write fragments atomically; one malformed file prevents all SSH connections.
Include ~/.ssh/config.d/*.conf

# Select the personal identity even when a work fragment owns github.com.
# IdentitiesOnly requires the selector file and prevents fallback to other keys.
# A separate ControlPath prevents reuse of another account's authenticated socket.
Host github-dotfiles
    HostName github.com
    User git
    IdentitiesOnly yes
    IdentityFile ~/.ssh/github-dotfiles.pub
    ControlPath ~/.ssh/cm-ghdotfiles-%C

Host *
    # Survive laptop sleep / NAT idle: probe every 30s, give up after 3 misses.
    ServerAliveInterval 30
    ServerAliveCountMax 3
    # %C keeps socket paths under macOS's 104-character limit. It hashes the
    # resolved host, not the alias or identity. Blocks with a separate IdentityFile
    # need a distinct literal ControlPath prefix to avoid sharing authentication.
    # Avoid %n in that prefix: long aliases can exceed the socket path limit.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    # Private keys stay in 1Password; local .pub files select agent identities.
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
