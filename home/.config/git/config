# -*- mode: gitconfig; -*-
# vim: set filetype=gitconfig:

[user]
    name = Steven Carpenter
    email = 13987584+stevencarpenter@users.noreply.github.com

[core]
    excludesfile = ~/.config/git/.gitignore_global
    editor = nvim
    pager = delta
    autocrlf = input

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    conflictStyle = zdiff3

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[alias]
    wt = worktree
    lswt = worktree list
    mkwt = "!f() { git worktree add \"$(git rev-parse --show-toplevel)+$@\"; }; f"
    rmwt = "!f() { git worktree remove \"$(git rev-parse --show-toplevel)+$@\"; }; f"

# Extension seams (LOCKED contract). git include has NO glob support, so the
# seam is two fixed filenames; git silently skips missing include files.
# Paths resolve relative to this file's directory.
[include]
    path = conf.d/extra.inc

# Self-scoping work identity: active only inside ~/work/ checkouts.
[includeIf "gitdir:~/work/"]
    path = conf.d/work.inc
