#!/usr/bin/env bash
# JankyBorders: focused-window border highlights
# Everforest Dark Hard palette

set -euo pipefail

# Keep width aligned with the AeroSpace variants' focus hook and gaps
# to prevent overlapping or clipped window borders.
options=(
    style=round
    width=3.0
    hidpi=on
    active_color=0xffa7c080
    inactive_color=0xff4b565c
)

borders "${options[@]}"
