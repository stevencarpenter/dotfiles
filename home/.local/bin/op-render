#!/usr/bin/env bash
# op-render — render op:// templates to 0600 secret files via 1Password Connect.
#
# Reads a manifest of `template:target` lines and, for each, `op inject`s the
# template to a same-directory tmpfile, then atomically mv's it over a 0600
# target ONLY if op inject succeeded and the output is non-empty. Never renders
# in place: a Connect/Tailscale outage must leave the previous good file intact,
# not truncate it (this box may only be reachable over the ssh config it renders).
#
# Auth: renders if EITHER OP_CONNECT_HOST + OP_CONNECT_TOKEN are set (Connect
# mode, e.g. i9) OR an interactive `op` desktop-app session is available (e.g.
# m5), checked via `op whoami`. `op account list` is intentionally insufficient:
# it succeeds for a configured-but-signed-out account and would let `op inject`
# block activation waiting for authentication. Connect creds take precedence when both
# are present. If neither is available, it skips with exit 0 (leaves existing
# files untouched) rather than failing a boot or a nix activation. bash 3.2
# safe (macOS default shell).
#
# Env overrides: OP_BIN (default `op`), OP_RENDER_MANIFEST
# (default ~/.config/op/render-manifest).
set -uo pipefail

OP_BIN="${OP_BIN:-op}"
MANIFEST="${OP_RENDER_MANIFEST:-$HOME/.config/op/render-manifest}"
# Staleness sentinel: touched after a fully successful render. Lets the skip
# path below distinguish "skipped once" from "skipping for weeks" — without it
# a broken op integration decays secrets silently behind a one-line warning.
SENTINEL="$(dirname "$MANIFEST")/.last-render"
STALE_DAYS="${OP_RENDER_STALE_DAYS:-7}"

log() { printf 'op-render: %s\n' "$*" >&2; }

warn_if_stale() {
  if [ ! -e "$SENTINEL" ]; then
    log "WARNING: no successful render on record; rendered secrets may be arbitrarily stale."
  elif [ -n "$(find "$SENTINEL" -mtime "+$STALE_DAYS" 2>/dev/null)" ]; then
    log "WARNING: last successful render was $(stat -f '%Sm' "$SENTINEL") (>$STALE_DAYS days ago); rendered secrets are going stale. Fix op auth and re-run op-render."
  fi
}

if [ -n "${OP_CONNECT_HOST:-}" ] && [ -n "${OP_CONNECT_TOKEN:-}" ]; then
  :  # Connect mode (headless, e.g. i9)
elif "$OP_BIN" whoami >/dev/null 2>&1; then
  :  # interactive desktop-app session (e.g. m5)
else
  log "no op auth (no Connect creds, no interactive session); skipping (files left intact)."
  warn_if_stale
  exit 0
fi

[ -f "$MANIFEST" ] || { log "no manifest at $MANIFEST; nothing to render."; exit 0; }

rc=0
while IFS=: read -r tpl target; do
  [ -z "${tpl:-}" ] && continue
  case "$tpl" in \#*) continue ;; esac

  tpl="${tpl/#\~/$HOME}"
  target="${target/#\~/$HOME}"
  dir="$(dirname "$target")"
  mkdir -p "$dir"

  tmp="$(mktemp "$dir/.op-render.XXXXXX")" || { log "mktemp failed for $target"; rc=1; continue; }

  # --force: mktemp already created $tmp, and `op inject -o <existing>` aborts
  # asking for confirmation without it. $tmp is our own 0600 tmpfile, so
  # overwriting it is intended.
  if ! "$OP_BIN" inject --force -i "$tpl" -o "$tmp" >/dev/null 2>&1; then
    log "op inject failed for $tpl (keeping existing $target)"
    rm -f "$tmp"; rc=1; continue
  fi
  if [ ! -s "$tmp" ]; then
    log "rendered $tpl is empty (keeping existing $target)"
    rm -f "$tmp"; rc=1; continue
  fi

  chmod 0600 "$tmp"
  mv -f "$tmp" "$target"          # same-filesystem rename → atomic
  log "rendered $target"
done < "$MANIFEST"

if [ "$rc" -eq 0 ]; then
  touch "$SENTINEL"
else
  warn_if_stale
fi
exit "$rc"
