#!/usr/bin/env bash
# gh — route GitHub CLI calls to the account that owns the current repo.
#
# THE PROBLEM: `gh` has exactly one *active* account per host. There is no
# per-repo, per-directory, or config-file account selection (checked on gh
# 2.97: only `gh auth token --user` names an account; everything else follows
# the active one). On a machine logged into both a work and a personal account,
# whichever is active loses in the other's repos — and git and gh disagree in a
# way that reads as a permissions bug rather than an account bug:
#
#   $ git push        # works — the remote's SSH key decides
#   $ gh pr create    # GraphQL: <other-user> does not have the correct permissions
#
# WHY A SCRIPT ON PATH AND NOT A SHELL FUNCTION: this logic began as a zsh
# function (see ../../.config/zsh/lib/gh-account.zsh), which covered
# hand-typed `gh` and nothing else. A shell function does not exist for any
# subprocess, so every non-zsh caller silently bypassed it — most importantly
# coding agents, which run tools through a non-interactive bash shell and hit
# exactly the CreatePullRequest failure above.
#
# Being on PATH also fixes the wrapper's biggest blind spot for free: gh-axi
# shells out to the `gh` BINARY, so routing now applies however it is invoked —
# `npx -y gh-axi@<pin>`, an installed copy, or the convenience function — with
# no gh-axi-specific wrapper needed.
#
# SAFETY POSTURE: a GitHub token with full write scope is readable by every
# same-user process while it sits in an environment, so it is passed to one
# command and dies with it. Never exported, never written to disk. Same
# discipline the op-render path uses for OP_SESSION_*.
#
# This wrapper must never be the reason `gh` fails. Every routing step degrades
# to plain `gh` rather than erroring, and `set -e` is deliberately NOT used.
set -uo pipefail

# ---- locate the real gh -----------------------------------------------------
# Resolve by PATH rather than hardcoding a path, which keeps the mise shim in
# play: `gh` here is ~/.local/share/mise/shims/gh, and hardcoding
# /opt/homebrew/bin/gh would quietly bypass the version mise selects.
#
# Excluding only our OWN directory is not enough, and the failure is a hang
# rather than an error. A mise shim whose tool is not active in the current
# directory does not fail — it falls back to a PATH lookup, which finds this
# wrapper again, which calls the shim again, forever:
#
#   ~/.local/bin/gh -> mise shim -> PATH lookup -> ~/.local/bin/gh -> ...
#
# So carry the directories already tried across re-entry. Each bounce then
# resolves strictly further down PATH and the chain terminates. This is
# deliberately generic: any shim that defers to PATH behaves this way, and
# special-casing mise would leave the next one to rediscover.
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
skip="${_GH_ACCOUNT_WRAPPER_SKIP:-}"

path_without_tried() {
  local out="" e r
  local IFS=':'
  for e in ${PATH}; do
    [ -n "${e}" ] || continue
    # -P so a symlinked PATH entry still compares equal.
    r="$(cd "${e}" 2>/dev/null && pwd -P)" || continue
    [ "${r}" = "${self_dir}" ] && continue
    case ":${skip}:" in
    *":${r}:"*) continue ;;
    esac
    out="${out:+${out}:}${e}"
  done
  printf '%s' "${out}"
}

real_gh="$(PATH="$(path_without_tried)" command -v gh 2>/dev/null)"
if [ -z "${real_gh}" ]; then
  echo "gh: real gh binary not found on PATH (wrapper at ${self_dir}/gh)" >&2
  exit 127
fi

real_dir="$(cd "$(dirname "${real_gh}")" && pwd -P)"
export _GH_ACCOUNT_WRAPPER_SKIP="${skip:+${skip}:}${real_dir}"

# A non-empty inherited skip list means we were re-entered through a shim's
# PATH fallback. The outer invocation is already doing the routing, so just
# hand off — routing again would re-run `auth token` on every bounce.
if [ -n "${skip}" ]; then
  exec "${real_gh}" "$@"
fi

# ---- cases that must not be routed ------------------------------------------
# `gh auth ...` must NOT see a forced GH_TOKEN: `auth switch`/`auth login`
# refuse to run while it is set, and `auth status` would report the injected
# token instead of real account state. Managing accounts has to stay possible
# from inside a mapped repo.
if [ "${1:-}" = "auth" ]; then
  exec "${real_gh}" "$@"
fi

# An explicit token from the caller wins. CI sets GH_TOKEN/GITHUB_TOKEN
# deliberately, and overriding it with a local keyring account would be both
# surprising and wrong.
if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
  exec "${real_gh}" "$@"
fi

# GH_TOKEN is the github.com token variable. Never inject one while gh is
# explicitly targeting a GitHub Enterprise host: even if the command later
# overrides its repository, passing an unrelated full-write credential into
# that process violates the wrapper's account/host boundary.
case "${GH_HOST:-github.com}" in
github.com) ;;
*) exec "${real_gh}" "$@" ;;
esac

# ---- owner -> account -------------------------------------------------------
# Owners absent from this map fall through to whatever account is active, so a
# work repo needs no entry and gets no surprises. This is the ONLY owner map —
# the zsh lib's GH_ACCOUNT_BY_OWNER was deleted along with its gh() function,
# so there is nothing to keep in sync.
account_for_owner() {
  case "$1" in
  stevencarpenter) echo "stevencarpenter" ;;
  *) return 1 ;;
  esac
}

# Print "host<TAB>owner" for an explicit gh repository selector. gh accepts
# OWNER/REPO and HOST/OWNER/REPO for GH_REPO and -R/--repo.
explicit_repo_identity() {
  local repo="$1" first second third rest
  IFS='/' read -r first second third rest <<<"${repo}"
  if [ -n "${first}" ] && [ -n "${second}" ] && [ -z "${third}" ]; then
    printf 'github.com\t%s\n' "${first}"
  elif [ -n "${first}" ] && [ -n "${second}" ] && [ -n "${third}" ] && [ -z "${rest}" ]; then
    printf '%s\t%s\n' "${first}" "${second}"
  else
    return 1
  fi
}

# Print "host<TAB>owner" for the current repository's origin. Unlike the old
# suffix-only regex, this also proves the remote is github.com (or the explicit
# personal SSH alias) before a github.com token enters the child environment.
origin_identity() {
  local url slug authority host path owner repo
  url="$(git remote get-url origin 2>/dev/null)" || return 1
  [ -n "${url}" ] || return 1
  slug="${url%.git}"
  case "${slug}" in
  *://*)
    authority="${slug#*://}"
    host="${authority%%/*}"
    path="${authority#*/}"
    host="${host##*@}"
    host="${host%%:*}"
    ;;
  *:*)
    authority="${slug%%:*}"
    path="${slug#*:}"
    host="${authority##*@}"
    ;;
  *) return 1 ;;
  esac
  owner="${path%%/*}"
  repo="${path#*/}"
  [ -n "${owner}" ] && [ -n "${repo}" ] && [ "${repo}" != "${path}" ] || return 1
  case "${host}" in
  github.com | github-dotfiles) printf 'github.com\t%s\n' "${owner}" ;;
  *) return 1 ;;
  esac
}

# Command-line -R/--repo overrides GH_REPO, and either overrides $PWD. This is
# load-bearing for gh-axi and for `gh -R other-owner/repo ...`: choosing the
# account from the current checkout would authenticate the explicit target as
# the wrong actor.
explicit_repo=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
  --) break ;;
  -R | --repo)
    if ((i + 1 < ${#args[@]})); then
      explicit_repo="${args[i + 1]}"
    fi
    ;;
  --repo=*) explicit_repo="${args[i]#--repo=}" ;;
  -R?*) explicit_repo="${args[i]#-R}" ;;
  esac
done
[ -n "${explicit_repo}" ] || explicit_repo="${GH_REPO:-}"

identity=""
if [ -n "${explicit_repo}" ]; then
  identity="$(explicit_repo_identity "${explicit_repo}")" || exec "${real_gh}" "$@"
else
  identity="$(origin_identity)" || exec "${real_gh}" "$@"
fi
host="${identity%%$'\t'*}"
owner="${identity#*$'\t'}"
[ "${host}" = github.com ] || exec "${real_gh}" "$@"

account="$(account_for_owner "${owner}")" || exec "${real_gh}" "$@"

# The machine may simply not be logged into the mapped account. That is not
# worth interrupting a command over — fall through to the active account.
token="$(GH_HOST=github.com "${real_gh}" auth token --user "${account}" --hostname github.com 2>/dev/null)" || token=""
[ -n "${token}" ] || exec "${real_gh}" "$@"

GH_TOKEN="${token}" exec "${real_gh}" "$@"
