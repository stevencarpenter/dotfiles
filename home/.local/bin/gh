#!/usr/bin/env bash
# gh: route GitHub CLI calls to the account that owns the current repo.
#
# gh selects one active account per host. This PATH wrapper also routes callers
# such as gh-axi that cannot use a shell function.
# Keep the token in the child command environment only; never persist it.
# Routing failures fall back to gh, so errexit is disabled.
set -uo pipefail

# ---- locate the real gh -----------------------------------------------------
# Resolve through PATH to retain mise version selection. Track tried directories
# across shim fallback to prevent wrapper/shim recursion.
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
skip="${_GH_ACCOUNT_WRAPPER_SKIP:-}"

path_without_tried() {
  local out="" e r
  local IFS=':'
  for e in ${PATH}; do
    [ -n "${e}" ] || continue
    # -P so a symlinked PATH entry still compares equal.
    r="$(cd "${e}" 2>/dev/null && pwd -P)" || continue
    [ "${r}" = "${self_dir}" ] && continue
    case ":${skip}:" in
    *":${r}:"*) continue ;;
    esac
    out="${out:+${out}:}${e}"
  done
  printf '%s' "${out}"
}

real_gh="$(PATH="$(path_without_tried)" command -v gh 2>/dev/null)"
if [ -z "${real_gh}" ]; then
  echo "gh: real gh binary not found on PATH (wrapper at ${self_dir}/gh)" >&2
  exit 127
fi

real_dir="$(cd "$(dirname "${real_gh}")" && pwd -P)"
export _GH_ACCOUNT_WRAPPER_SKIP="${skip:+${skip}:}${real_dir}"

# A non-empty inherited skip list means we were re-entered through a shim's
# PATH fallback. The outer invocation is already doing the routing, so just
# hand off: routing again would re-run `auth token` on every bounce.
if [ -n "${skip}" ]; then
  exec "${real_gh}" "$@"
fi

# ---- cases that must not be routed ------------------------------------------
# `gh auth ...` must NOT see a forced GH_TOKEN: `auth switch`/`auth login`
# refuse to run while it is set, and `auth status` would report the injected
# token instead of real account state. Managing accounts has to stay possible
# from inside a mapped repo.
if [ "${1:-}" = "auth" ]; then
  exec "${real_gh}" "$@"
fi

# Preserve explicit caller credentials, including CI tokens.
if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
  exec "${real_gh}" "$@"
fi

# GH_TOKEN is the github.com token variable. Never inject one while gh is
# explicitly targeting a GitHub Enterprise host: even if the command later
# overrides its repository, passing an unrelated full-write credential into
# that process violates the wrapper's account/host boundary.
case "${GH_HOST:-github.com}" in
github.com) ;;
*) exec "${real_gh}" "$@" ;;
esac

# ---- owner -> account -------------------------------------------------------
# Unmapped owners use the active account. Keep account mappings here.
account_for_owner() {
  case "$1" in
  stevencarpenter) echo "stevencarpenter" ;;
  *) return 1 ;;
  esac
}

# Print "host<TAB>owner" for an explicit gh repository selector. gh accepts
# OWNER/REPO and HOST/OWNER/REPO for GH_REPO and -R/--repo.
explicit_repo_identity() {
  local repo="$1" first second third rest
  IFS='/' read -r first second third rest <<<"${repo}"
  if [ -n "${first}" ] && [ -n "${second}" ] && [ -z "${third}" ]; then
    printf 'github.com\t%s\n' "${first}"
  elif [ -n "${first}" ] && [ -n "${second}" ] && [ -n "${third}" ] && [ -z "${rest}" ]; then
    printf '%s\t%s\n' "${first}" "${second}"
  else
    return 1
  fi
}

# Accept only github.com or its personal SSH alias before passing a token.
origin_identity() {
  local url slug authority host path owner repo
  url="$(git remote get-url origin 2>/dev/null)" || return 1
  [ -n "${url}" ] || return 1
  slug="${url%.git}"
  case "${slug}" in
  *://*)
    authority="${slug#*://}"
    host="${authority%%/*}"
    path="${authority#*/}"
    host="${host##*@}"
    host="${host%%:*}"
    ;;
  *:*)
    authority="${slug%%:*}"
    path="${slug#*:}"
    host="${authority##*@}"
    ;;
  *) return 1 ;;
  esac
  owner="${path%%/*}"
  repo="${path#*/}"
  [ -n "${owner}" ] && [ -n "${repo}" ] && [ "${repo}" != "${path}" ] || return 1
  case "${host}" in
  github.com | github-dotfiles) printf 'github.com\t%s\n' "${owner}" ;;
  *) return 1 ;;
  esac
}

# Account selection follows gh precedence: -R/--repo, GH_REPO, then origin.
explicit_repo=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
  --) break ;;
  -R | --repo)
    if ((i + 1 < ${#args[@]})); then
      explicit_repo="${args[i + 1]}"
    fi
    ;;
  --repo=*) explicit_repo="${args[i]#--repo=}" ;;
  -R?*) explicit_repo="${args[i]#-R}" ;;
  esac
done
[ -n "${explicit_repo}" ] || explicit_repo="${GH_REPO:-}"

identity=""
if [ -n "${explicit_repo}" ]; then
  identity="$(explicit_repo_identity "${explicit_repo}")" || exec "${real_gh}" "$@"
else
  identity="$(origin_identity)" || exec "${real_gh}" "$@"
fi
host="${identity%%$'\t'*}"
owner="${identity#*$'\t'}"
[ "${host}" = github.com ] || exec "${real_gh}" "$@"

account="$(account_for_owner "${owner}")" || exec "${real_gh}" "$@"

# Use the active account if the mapped account has no local token.
token="$(GH_HOST=github.com "${real_gh}" auth token --user "${account}" --hostname github.com 2>/dev/null)" || token=""
[ -n "${token}" ] || exec "${real_gh}" "$@"

GH_TOKEN="${token}" exec "${real_gh}" "$@"
