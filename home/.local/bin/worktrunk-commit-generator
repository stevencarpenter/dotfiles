#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Generate Worktrunk commit messages and reject malformed model output.

Two validation modes, because they guard different things:

``--validate`` checks a *model-generated* candidate and includes the
AI-attribution rule, which is a content rule about what a model tends to
emit about itself.

``--validate-commit-file`` checks a commit message file on its way into
git (the lefthook ``commit-msg`` job) and deliberately omits that rule:
`fix: tune Claude hook timeout` is a legitimate subject in this repo, and
the attribution rule is already enforced on that path by
scripts/strip-claude-trailer.sh and the no-em-dash-commit PreToolUse hook.
It also applies git's own message semantics (comment lines, the scissors
line) and exempts the subjects git itself generates.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

CONVENTIONAL_SUBJECT = re.compile(
    r"^(?:build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)"
    r"(?:\([A-Za-z0-9._/-]+\))?!?: \S.*$"
)
PROHIBITED_AI_REFERENCE = re.compile(
    r"(?:"
    r"co-authored-by|"
    r"\b(?:Claude|Codex|Copilot|Gemini|OpenAI|ChatGPT|GPT-?\d[\w.-]*)\b|"
    r"\b(?:generated|created|written|authored|produced)\s+by\s+"
    r"(?:an?\s+)?(?:AI|Claude|Codex|Copilot|Gemini|assistant|agent|model|harness)\b|"
    r"\bAI[- ](?:agent|assistant)\b|"
    r"\bAI[- ]generated\b"
    r")",
    re.IGNORECASE,
)
# Subjects git writes itself, or that mark a message for rebase to consume.
# None are Conventional and none are the author's to reword, so a commit-msg
# gate has to let them through or it breaks `git revert`, `git merge`, and
# `git commit --fixup`.
GIT_GENERATED_SUBJECT = re.compile(
    r'^(?:Revert "|Reapply "|Merge |fixup!|squash!|amend!)'
)
# `git commit --verbose` appends the staged diff after this line; everything
# from it onward is stripped by git and is not part of the message.
SCISSORS = "# ------------------------ >8 ------------------------"


def strip_git_comments(text: str) -> str:
    """Remove what git removes from a message file before committing.

    Args:
        text: Raw contents of the ``COMMIT_EDITMSG`` file.

    Returns:
        The message as git will record it: comment lines dropped, everything
        from the ``--verbose`` scissors line onward discarded, and surrounding
        blank lines trimmed.
    """
    lines: list[str] = []
    for line in text.splitlines():
        if line.rstrip() == SCISSORS:
            break
        if line.startswith("#"):
            continue
        lines.append(line)
    return "\n".join(lines).strip("\n")


CLAUDE_FLAGS = (
    "-p",
    "--no-session-persistence",
    "--model=haiku",
    "--tools=",
    "--safe-mode",
    "--disable-slash-commands",
    "--setting-sources=user",
    "--system-prompt=",
)


@dataclass(frozen=True)
class ValidationResult:
    """The normalized candidate and any validation failures."""

    candidate: str
    errors: tuple[str, ...]


def delimiter_error(message: str) -> str | None:
    """Return an error for unbalanced structural delimiters or quotes."""
    pairs = {")": "(", "]": "[", "}": "{"}
    openings = set(pairs.values())
    stack: list[str] = []
    quote: str | None = None
    escaped = False

    for index, character in enumerate(message):
        if escaped:
            escaped = False
            continue
        if character == "\\":
            escaped = True
            continue
        if quote is not None:
            if character == quote:
                quote = None
            continue
        if character in {'"', "`"}:
            quote = character
            continue
        if character in openings:
            stack.append(character)
        elif character in pairs and (not stack or stack.pop() != pairs[character]):
            return f"unmatched delimiter: {character}"

    if quote is not None:
        return f"unmatched quote: {quote}"
    if stack:
        return f"unmatched delimiter: {stack[-1]}"
    return None


def validate(message: str, check_ai_reference: bool = True) -> ValidationResult:
    """Validate one commit message without rewriting its content.

    Args:
        message: Candidate commit message.
        check_ai_reference: Apply the AI-attribution rule. True for
            model-generated candidates; False for a human-or-agent commit
            message file, where naming Claude in a subject is legitimate and
            the attribution rule is enforced elsewhere on that path.

    Returns:
        The normalized candidate and every rule it violates.
    """
    candidate = message.rstrip("\r\n")
    errors: list[str] = []
    lines = candidate.splitlines()
    subject = lines[0] if lines else ""

    if not CONVENTIONAL_SUBJECT.fullmatch(subject):
        errors.append("first line must be a Conventional Commit subject")
    if subject.endswith("."):
        errors.append("subject must not end with a period")
    if len(lines) > 1 and lines[1] != "":
        errors.append("body or explanation must follow a blank line")
    if check_ai_reference and PROHIBITED_AI_REFERENCE.search(candidate):
        errors.append("message must not reference AI tools or attribution")
    if error := delimiter_error(candidate):
        errors.append(error)

    return ValidationResult(candidate=candidate, errors=tuple(errors))


def positive_attempt_count() -> int:
    """Read the retry count and fail clearly on invalid configuration."""
    raw = os.environ.get("WORKTRUNK_COMMIT_ATTEMPTS", "2")
    try:
        attempts = int(raw)
    except ValueError:
        attempts = 0
    if attempts < 1:
        raise ValueError("WORKTRUNK_COMMIT_ATTEMPTS must be a positive integer")
    return attempts


def claude_environment() -> dict[str, str]:
    """Build the hermetic environment required by the existing safe invocation."""
    environment = os.environ.copy()
    environment["CLAUDECODE"] = ""
    environment["MAX_THINKING_TOKENS"] = "0"
    return environment


def correction_prompt(prompt: str, errors: tuple[str, ...]) -> str:
    """Append deterministic local feedback for the next generation attempt."""
    details = "; ".join(errors)
    return (
        f"{prompt.rstrip()}\n\n"
        "The previous candidate failed local validation: "
        f"{details}. Return only a corrected commit message."
    )


def generate(prompt: str) -> int:
    """Run Claude with retries, emitting only a locally validated candidate."""
    try:
        attempts = positive_attempt_count()
    except ValueError as error:
        print(f"worktrunk-commit-generator: {error}", file=sys.stderr)
        return 2

    claude_bin = os.environ.get("CLAUDE_BIN", "claude")
    current_prompt = prompt
    last_errors: tuple[str, ...] = ("generation did not run",)
    for attempt in range(1, attempts + 1):
        try:
            result = subprocess.run(
                (claude_bin, *CLAUDE_FLAGS),
                input=current_prompt,
                text=True,
                capture_output=True,
                check=False,
                env=claude_environment(),
            )
        except OSError as error:
            last_errors = (f"Claude invocation failed: {error}",)
        else:
            if result.returncode != 0:
                last_errors = (f"Claude invocation exited {result.returncode}",)
            else:
                validation = validate(result.stdout)
                if not validation.errors:
                    print(validation.candidate)
                    return 0
                last_errors = validation.errors

        if attempt < attempts:
            current_prompt = correction_prompt(prompt, last_errors)

    print(
        "worktrunk-commit-generator: rejected generated commit message after "
        f"{attempts} attempts: {'; '.join(last_errors)}",
        file=sys.stderr,
    )
    return 1


def main() -> int:
    """Run generation or the deterministic stdin-only validation mode."""
    if len(sys.argv) == 2 and sys.argv[1] == "--validate":
        result = validate(sys.stdin.read())
        if result.errors:
            print("; ".join(result.errors), file=sys.stderr)
            return 1
        print(result.candidate)
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "--validate-commit-file":
        try:
            raw = Path(sys.argv[2]).read_text(encoding="utf-8")
        except OSError as error:
            print(f"worktrunk-commit-generator: {error}", file=sys.stderr)
            return 2
        message = strip_git_comments(raw)
        if not message:
            return 0  # empty message: git aborts the commit on its own
        if GIT_GENERATED_SUBJECT.match(message.splitlines()[0]):
            return 0
        result = validate(message, check_ai_reference=False)
        if result.errors:
            print(
                "commit message rejected: " + "; ".join(result.errors),
                file=sys.stderr,
            )
            return 1
        return 0
    if len(sys.argv) != 1:
        print(
            "usage: worktrunk-commit-generator "
            "[--validate | --validate-commit-file PATH]",
            file=sys.stderr,
        )
        return 2
    return generate(sys.stdin.read())


if __name__ == "__main__":
    raise SystemExit(main())
