{
  "manifest_version": 3,
  "name": "Dashboard Tabs",
  "version": "1.0.0",
  "description": "Opens each Grafana dashboard set as its own collapsed tab group at browser startup.",
  "browser_specific_settings": {
    "gecko": {
      "id": "dashboard-tabs@sjcarpenter.com",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["tabGroups", "storage", "alarms", "sessions"],
  "host_permissions": [
    "http://localhost:3030/*",
    "https://grafana.snugmarina.org/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Open dashboard tab groups"
  }
}
