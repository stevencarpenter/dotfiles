  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local)",
      "options": {
        "baseURL": "http://localhost:42069/v1"
      },
      "models": {
        "Qwen3.8-Flash-Next-MLX-4bit": {
