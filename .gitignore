# Repo-local / machine-specific (defensive, files don't currently exist)
.envrc
*threat-model*.md

# All CLAUDE.md files except root and home/.claude/ (tracked) — explicit allowlist
**/CLAUDE.md
!/CLAUDE.md
!/home/.claude/CLAUDE.md

# Serena MCP cache
.serena/

# Codex sandbox env (machine-local)
/.codex/environments/environment.toml

# understand-anything: track the graph + fingerprints + meta, but not the
# transient per-run scratch dirs (recreated and deleted on each /understand run)
.understand-anything/intermediate/
.understand-anything/tmp/
.codegraph/
.agents/

# Nix build artifacts
# `result` symlinks left by `nix build` / `darwin-rebuild build`, and the
# per-directory direnv cache (`use flake`). flake.lock stays tracked.
result
result-*
.direnv/
.direnv

# Rendered 1Password targets must never enter the repository. Only their
# adjacent *.tpl sources and the exact-reference policy are tracked.
/home/.config/zsh/.personal.env
/home/.ssh/config
